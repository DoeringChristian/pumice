{
  "name": "pumice",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugins/*",
    "apps/*",
    "examples/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/link-excalidraw.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "npm run dev -w @pumice/web",
    "dev:desktop": "npm run dev -w @pumice/desktop",
    "build:desktop": "npm run build -w @pumice/desktop",
    "format": "prettier --write .",
    "docs:api": "typedoc",
    "screenshot": "npm exec -w @pumice/desktop -- electron-vite build && node scripts/screenshot.mjs",
    "serve": "npm run build -w @pumice/server -w @pumice/web && node apps/server/dist/main.js",
    "build:excalidraw": "cd vendor/excalidraw && npx -y yarn@1.22.22 install --frozen-lockfile --ignore-engines && npx -y yarn@1.22.22 build:packages"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "playwright": "1.49.1",
    "prettier": "^3.3.3",
    "typedoc": "~0.26.11",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "fsevents": true,
    "@parcel/watcher": false,
    "core-js": false
  }
}
