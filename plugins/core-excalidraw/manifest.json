{
  "id": "core.excalidraw",
  "name": "Excalidraw",
  "version": "0.1.0",
  "description": "Drawings as first-class notes: Obsidian-compatible .excalidraw.md files, embeds, links, search and collaboration.",
  "api": "^0.1.0",
  "dependencies": {
    "core.vault": "^0.1.0",
    "core.documents": "^0.1.0",
    "core.workspace": "^0.1.0",
    "core.markdown": "^0.1.0",
    "core.index": "^0.1.0"
  },
  "optionalDependencies": {
    "core.reader": "^0.1.0",
    "core.editor": "^0.1.0",
    "core.links": "^0.1.0",
    "core.files": "^0.1.0"
  },
  "contributes": {
    "commands": [
      {
        "id": "excalidraw.new",
        "title": "Create new drawing"
      }
    ],
    "fileTypes": [
      {
        "id": "excalidraw",
        "extensions": ["excalidraw.md", "excalidraw"]
      }
    ]
  },
  "permissions": ["shell"]
}
